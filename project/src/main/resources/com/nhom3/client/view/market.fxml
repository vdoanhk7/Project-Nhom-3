<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="700.0" prefWidth="1000.0" style="-fx-background-color: #f4f7f6;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.nhom3.client.controller.MarketController">
   
   <top>
      <VBox spacing="15.0" style="-fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 2);">
         <padding>
            <Insets bottom="20.0" left="30.0" right="30.0" top="20.0" />
         </padding>
         <children>
            <HBox alignment="CENTER_LEFT" spacing="20.0">
               <children>
                  <Label text="Sàn Đấu Giá Trực Tuyến" textFill="#2c3e50">
                     <font>
                        <Font name="System Bold" size="26.0" />
                     </font>
                  </Label>
                  <HBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS" spacing="10.0">
                     <children>
                        <TextField fx:id="txtSearch" prefHeight="40.0" prefWidth="350.0" promptText="Tìm kiếm sản phẩm đang đấu giá..." style="-fx-background-radius: 20; -fx-padding: 0 15;" />
                        <ComboBox fx:id="cbCategory" prefHeight="40.0" prefWidth="150.0" promptText="Tất Cả" style="-fx-background-radius: 20;" />
                        <Button fx:id="btnReload" mnemonicParsing="false" prefHeight="40.0" prefWidth="100.0" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-background-radius: 20; -fx-cursor: hand;" text="Làm Mới" />
                     </children>
                  </HBox>
               </children>
            </HBox>
         </children>
      </VBox>
   </top>

   <center>
      <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-padding: 20;">
         <content>
            <FlowPane fx:id="flowMarket" hgap="25.0" vgap="25.0" alignment="TOP_LEFT">
               <padding>
                  <Insets bottom="20.0" left="10.0" right="10.0" top="10.0" />
               </padding>
               </FlowPane>
         </content>
      </ScrollPane>
   </center>
   
</BorderPane>