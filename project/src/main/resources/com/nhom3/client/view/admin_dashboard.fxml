<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox prefHeight="700.0" prefWidth="1000.0" spacing="20" style="-fx-background-color: #f0f3f6;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.nhom3.client.controller.AdminDashboardController">
    <children>

        <HBox spacing="20">
            <padding><Insets left="20" right="20" /></padding>
            <children>
                <VBox alignment="CENTER" prefWidth="300.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
                    <children>
                        <Text fill="#7f8c8d" text="Tổng Thành Viên" />
                        <Text fx:id="txtTotalUsers" style="-fx-font-size: 24px; -fx-font-weight: bold;" text="---" />
                    </children>
                    <padding><Insets bottom="15" top="15" /></padding>
                </VBox>
                <VBox alignment="CENTER" prefWidth="300.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
                    <children>
                        <Text fill="#d35400" text="Phiên Đang Chạy" />
                        <Text fx:id="txtActiveAuctions" fill="#d35400" style="-fx-font-size: 24px; -fx-font-weight: bold;" text="---" />
                    </children>
                    <padding><Insets bottom="15" top="15" /></padding>
                </VBox>
                <VBox alignment="CENTER" prefWidth="300.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
                    <children>
                        <Text fill="#27ae60" text="Tổng Giao Dịch (VNĐ)" />
                        <Text fx:id="txtTotalValue" fill="#27ae60" style="-fx-font-size: 24px; -fx-font-weight: bold;" text="---" />
                    </children>
                    <padding><Insets bottom="15" top="15" /></padding>
                </VBox>
            </children>
        </HBox>

        <TabPane prefHeight="450.0" style="-fx-background-color: white; -fx-background-radius: 15;" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
            <VBox.margin><Insets bottom="20" left="20" right="20" /></VBox.margin>
            <tabs>
                <Tab text="Quản lý Người dùng">
                    <VBox spacing="10" style="-fx-padding: 15;">
                        <TableView fx:id="tableUsers" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colUserId" prefWidth="50" text="ID" />
                                <TableColumn fx:id="colUserName" prefWidth="150" text="Tên Đăng Nhập" />
                                <TableColumn fx:id="colUserRole" prefWidth="100" text="Vai Trò" />
                                <TableColumn fx:id="colUserAction" prefWidth="248.00006103515625" text="Thao Tác" sortable="false" />
                            </columns>
                        </TableView>
                    </VBox>
                </Tab>

                <Tab text="Quản lý Đấu giá">
                    <VBox spacing="10" style="-fx-padding: 15;">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Button fx:id="btnAllAuctions" style="-fx-background-color: #3498db; -fx-text-fill: white;" text="Tất cả Phiên Đấu Giá" />
                            <Button fx:id="btnOpenAuctions" style="-fx-background-color: #f39c12; -fx-text-fill: white;" text="Chờ Mở" />
                            <Button fx:id="btnRunningAuctions" style="-fx-background-color: #9b59b6; -fx-text-fill: white;" text="Đang Đấu Giá" />
                            <Button fx:id="btnSuccessfulSales" style="-fx-background-color: #27ae60; -fx-text-fill: white;" text="Đã Bán" />
                            <Button fx:id="btnCancelledAuctions" style="-fx-background-color: #e74c3c; -fx-text-fill: white;" text="Đã Hủy" />
                        </HBox>
                        <TableView fx:id="tableAuctions" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colAuctionId" prefWidth="50" text="ID" />
                                <TableColumn fx:id="colItemName" prefWidth="200" text="Sản Phẩm" />
                                <TableColumn fx:id="colSellerName" prefWidth="150" text="Người Bán" />
                                <TableColumn fx:id="colStatus" prefWidth="100" text="Trạng Thái" />
                                <TableColumn fx:id="colAuctionAction" prefWidth="200" text="Thao Tác ADMIN" sortable="false" />
                            </columns>
                        </TableView>
                    </VBox>
                </Tab>

                <Tab text="System Log">
                    <VBox spacing="10" style="-fx-padding: 15;">
                        <TextArea fx:id="txtSystemLogs" editable="false" style="-fx-font-family: 'Consolas', monospace;" wrapText="true" VBox.vgrow="ALWAYS" />
                    </VBox>
                </Tab>
            </tabs>
        </TabPane>
    </children>
</VBox>