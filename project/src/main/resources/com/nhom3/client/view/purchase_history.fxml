<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="750.0" prefWidth="1100.0" spacing="25.0" style="-fx-background-color: #F8FAFC;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.nhom3.client.controller.PurchaseHistoryController">
   <padding>
      <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
   </padding>
   <children>
      
      <!-- PHẦN 1: HEADER (Tiêu đề trang) -->
      <VBox spacing="5.0">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label text="Lịch Sử Đấu Giá" textFill="#0f172a">
                     <font>
                        <Font name="System Bold" size="28.0" />
                     </font>
                  </Label>
               </children>
            </HBox>
            <Label text="Theo dõi chi tiết các lượt đặt giá và kết quả những sản phẩm bạn đã tham gia." textFill="#64748b">
               <font>
                  <Font size="14.0" />
               </font>
            </Label>
         </children>
      </VBox>

      <!-- PHẦN 2: BỘ LỌC VÀ TÌM KIẾM -->
      <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 10, 0, 0, 2); -fx-border-color: #e2e8f0; -fx-border-radius: 12;">
         <children>
            <!-- Ô tìm kiếm -->
            <TextField fx:id="txtSearch" prefHeight="42.0" prefWidth="380.0" promptText="🔍 Nhập tên sản phẩm cần tìm kiếm..." style="-fx-padding: 0 15; -fx-background-radius: 8; -fx-border-color: #cbd5e1; -fx-border-radius: 8; -fx-background-color: #f8fafc; -fx-font-size: 14px;" />
            
            <Region HBox.hgrow="ALWAYS" />
            
            <!-- ComboBox Lọc -->
            <Label text="Trạng thái:" textFill="#475569">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
            </Label>
            <ComboBox fx:id="cbFilter" prefHeight="42.0" prefWidth="200.0" promptText="Lọc kết quả" style="-fx-background-color: #f8fafc; -fx-border-color: #cbd5e1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 14px;" />
         </children>
      </HBox>

      <!-- PHẦN 3: BẢNG DỮ LIỆU -->
      <VBox style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.04), 15, 0, 0, 4); -fx-border-color: #e2e8f0; -fx-border-radius: 12; -fx-padding: 5;" VBox.vgrow="ALWAYS">
         <children>
            <!-- 
                Sử dụng inline CSS để điều chỉnh cell size rộng ra, 
                giúp các nút bấm trong bảng được hiển thị thoải mái hơn 
            -->
            <TableView fx:id="tableHistory" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-fixed-cell-size: 50px; -fx-font-size: 14px;" VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="colItemName" prefWidth="250.0" style="-fx-alignment: CENTER_LEFT; -fx-font-weight: bold; -fx-text-fill: #1e293b; -fx-padding: 0 0 0 15px;" text="Sản Phẩm" />
                <TableColumn fx:id="colBidAmount" prefWidth="160.0" style="-fx-alignment: CENTER_RIGHT; -fx-font-weight: bold; -fx-text-fill: #059669;" text="Mức Giá Của Bạn" />
                <TableColumn fx:id="colBidTime" prefWidth="180.0" style="-fx-alignment: CENTER; -fx-text-fill: #64748b;" text="Thời Gian Đặt" />
                <TableColumn fx:id="colAuctionStatus" prefWidth="150.0" style="-fx-alignment: CENTER; -fx-text-fill: #475569;" text="Trạng Thái Phiên" />
                <TableColumn fx:id="colResult" prefWidth="220.0" style="-fx-alignment: CENTER;" text="Kết Quả" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>

   </children>
</VBox>