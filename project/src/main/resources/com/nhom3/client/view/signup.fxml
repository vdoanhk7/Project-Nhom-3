<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="550.0" prefWidth="400.0" spacing="12.0" style="-fx-background-color: #ffffff;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.nhom3.client.controller.SignupController">
    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
    </padding>
   <children>
       
       <Label text="✨ TẠO TÀI KHOẢN" textFill="#2ecc71">
           <font>
               <Font name="System Bold" size="22.0" />
           </font>
       </Label>
       <Label text="Điền thông tin để tham gia đấu giá" textFill="#7f8c8d">
           <VBox.margin>
               <Insets bottom="15.0" />
           </VBox.margin>
       </Label>
       
       <VBox spacing="5.0">
           <Label text="Họ và tên:" textFill="#34495e">
            <font>
               <Font name="System Bold" size="12.0" />
            </font></Label>
           <TextField fx:id="txtFullName" promptText="VD: Nguyễn Văn A..." style="-fx-padding: 10; -fx-background-radius: 5; -fx-border-color: #bdc3c7;" />
       </VBox>
   
       <VBox spacing="5.0">
           <Label text="Tên đăng nhập:" textFill="#34495e">
            <font>
               <Font name="System Bold" size="12.0" />
            </font></Label>
           <TextField fx:id="txtUsername" promptText="Nhập tên đăng nhập..." style="-fx-padding: 10; -fx-background-radius: 5; -fx-border-color: #bdc3c7;" />
       </VBox>
       
       <VBox spacing="5.0">
           <Label text="Mật khẩu:" textFill="#34495e">
            <font>
               <Font name="System Bold" size="12.0" />
            </font></Label>
           <PasswordField fx:id="txtPassword" promptText="Nhập mật khẩu..." style="-fx-padding: 10; -fx-background-radius: 5; -fx-border-color: #bdc3c7;" />
       </VBox>
   
       <VBox spacing="5.0">
           <Label text="Xác nhận mật khẩu:" textFill="#34495e">
            <font>
               <Font name="System Bold" size="12.0" />
            </font></Label>
           <PasswordField fx:id="txtConfirmPassword" promptText="Nhập lại mật khẩu..." style="-fx-padding: 10; -fx-background-radius: 5; -fx-border-color: #bdc3c7;" />
       </VBox>
       
       <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleSignup" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-padding: 10; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 5;" text="ĐĂNG KÝ NGAY">
           <VBox.margin>
               <Insets top="15.0" />
           </VBox.margin>
       </Button>
       
       <HBox alignment="CENTER" spacing="5.0">
           <VBox.margin>
               <Insets top="10.0" />
           </VBox.margin>
           <Label text="Đã có tài khoản?" textFill="#7f8c8d" />
           <Hyperlink onAction="#goToLogin" style="-fx-font-weight: bold;" text="Đăng nhập" textFill="#3498db" />
       </HBox>
   </children>
</VBox>
