<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="800.0" prefWidth="978.0" spacing="20.0" style="-fx-background-color: #f4f6f9;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.nhom3.client.controller.ManageItemController">
   <padding>
      <Insets bottom="20.0" left="25.0" right="25.0" top="25.0" />
   </padding>
   <children>
      
      <!-- PHẦN 1: HEADER -->
      <HBox alignment="CENTER_LEFT">
         <children>
            <Label text="📦 Quản Lý Sản Phẩm" textFill="#2c3e50">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Label>
            <Region HBox.hgrow="ALWAYS" />
            <!-- Nút Thêm Mới -->
            <Button mnemonicParsing="false" onAction="#handleAddNewItem" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 5;" text="+ Thêm Sản Phẩm Mới">
               <padding>
                  <Insets bottom="10.0" left="15.0" right="15.0" top="10.0" />
               </padding>
               <font>
                  <Font size="14.0" />
               </font>
            </Button>
         </children>
      </HBox>

      <!-- PHẦN 2: BỘ LỌC TÌM KIẾM -->
      <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 0);">
         <children>
            <TextField fx:id="txtSearch" prefWidth="300.0" promptText="🔍 Nhập Tên Sản Phẩm / Mã SP cần tìm..." style="-fx-padding: 8; -fx-background-radius: 5; -fx-border-color: #bdc3c7;" />
            
            <ComboBox fx:id="cbCategory" prefWidth="180.0" promptText="Phân loại (Type)" style="-fx-background-color: #ffffff; -fx-border-color: #bdc3c7; -fx-border-radius: 5;" />
            
            <Region HBox.hgrow="ALWAYS" />
         </children>
      </HBox>

      <!-- PHẦN 3: BẢNG DỮ LIỆU SẢN PHẨM -->
      <TableView fx:id="tableItems" style="-fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 0);" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="colId" prefWidth="60.0" style="-fx-alignment: CENTER;" text="Mã SP" />
          <TableColumn fx:id="colImage" prefWidth="100.0" style="-fx-alignment: CENTER;" text="Hình Ảnh" />
          <TableColumn fx:id="colName" prefWidth="201.0" text="Tên Sản Phẩm" />
          <TableColumn fx:id="colType" prefWidth="113.30935668945312" style="-fx-alignment: CENTER;" text="Phân Loại" />
          <TableColumn fx:id="colStartPrice" prefWidth="140.0" style="-fx-alignment: CENTER_RIGHT;" text="Giá Khởi Điểm" />
          <TableColumn fx:id="colCurHighest" prefWidth="140.0" style="-fx-alignment: CENTER_RIGHT;" text="Giá Hiện Tại" />
          <TableColumn fx:id="colAction" prefWidth="250.88677978515625" style="-fx-alignment: CENTER;" text="Thao Tác" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>

   </children>
</VBox>
