<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="750.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.nhom3.client.controller.MainController">
   
   <!-- PHẦN TOP: Thanh Header nổi 3D -->
   <top>
      <HBox alignment="CENTER_LEFT" prefHeight="70.0" style="-fx-background-color: #ffffff;" BorderPane.alignment="CENTER">
         <children>
            <!-- Logo Typographic chuyên nghiệp -->
            <HBox alignment="CENTER" spacing="8.0">
               <children>
                  <Label alignment="CENTER" prefHeight="35.0" prefWidth="35.0" style="-fx-background-color: linear-gradient(to bottom right, #3498db, #2980b9); -fx-text-fill: white; -fx-background-radius: 10;" text="A">
                     <font><Font name="System Bold" size="22.0" /></font>
                     <effect>
                        <DropShadow color="#3498db66" offsetY="3.0" radius="4.0" />
                     </effect>
                  </Label>
                  <Label text="AUCTION" textFill="#2c3e50">
                     <font><Font name="System Bold" size="20.0" /></font>
                  </Label>
                  <Label text="PRO" textFill="#3498db">
                     <font><Font name="System Bold" size="20.0" /></font>
                  </Label>
               </children>
               <HBox.margin>
                  <Insets left="25.0" />
               </HBox.margin>
            </HBox>
            
            <Region HBox.hgrow="ALWAYS" />
            
            <!-- Khu vực User Profile -->
            <HBox alignment="CENTER" spacing="12.0" style="-fx-background-color: #f4f6f9; -fx-padding: 6 15 6 8; -fx-background-radius: 30;">
               <children>
                  <Circle fx:id="circleUserAvatar" fill="#95a5a6" radius="16.0" />
                  <Label fx:id="lblUserName" text="User Name" textFill="#34495e">
                     <font><Font name="System Bold" size="14.0" /></font>
                  </Label>
               </children>
               <HBox.margin>
                  <Insets right="20.0" />
               </HBox.margin>
            </HBox>

            <!-- Nút Đăng xuất -->
            <Button mnemonicParsing="false" onAction="#handleLogout" style="-fx-background-color: #fdeaea; -fx-text-fill: #e74c3c; -fx-background-radius: 20; -fx-cursor: hand; -fx-padding: 8 20 8 20;" text="Đăng xuất">
               <font><Font name="System Bold" size="13.0" /></font>
            </Button>
         </children>
         <padding>
            <Insets right="30.0" />
         </padding>
         <effect>
            <DropShadow color="#0000000d" height="15.0" offsetY="3.0" radius="7.0" width="15.0" />
         </effect>
      </HBox>
   </top>

   <!-- PHẦN LEFT: Thanh Menu Sidebar -->
   <!-- Đã đổi sang tông màu Xanh Slate nhạt dần, sáng hơn đen nhưng vẫn có chiều sâu -->
   <left>
      <VBox prefWidth="270.0" style="-fx-background-color: linear-gradient(to bottom, #2b3d52, #1e2b3c);" BorderPane.alignment="CENTER">
         <children>
            <Label text="MENU ĐIỀU HƯỚNG" textFill="#8899a6">
               <font><Font name="System Bold" size="11.0" /></font>
               <VBox.margin>
                  <Insets bottom="15.0" left="30.0" top="35.0" />
               </VBox.margin>
            </Label>
            
            <VBox spacing="2.0">
               <children>
                  <Button fx:id="btnDashboard" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#showDashboard" style="-fx-background-color: transparent; -fx-text-fill: #d1d8e0; -fx-alignment: BASELINE_LEFT; -fx-cursor: hand; -fx-font-size: 15px;" text="        Tổng Quan">
                     <padding><Insets bottom="16.0" left="30.0" top="16.0" /></padding>
                  </Button>
                  
                  <Button fx:id="btnMarket" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#showMarket" style="-fx-background-color: transparent; -fx-text-fill: #d1d8e0; -fx-alignment: BASELINE_LEFT; -fx-cursor: hand; -fx-font-size: 15px;" text="        Chợ Đấu Giá">
                     <padding><Insets bottom="16.0" left="30.0" top="16.0" /></padding>
                  </Button>
                  
                  <Button fx:id="btnPurchaseHistory" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#showPurchaseHistory" style="-fx-background-color: transparent; -fx-text-fill: #d1d8e0; -fx-alignment: BASELINE_LEFT; -fx-cursor: hand; -fx-font-size: 15px;" text="        Lịch Sử Đấu Giá">
                     <padding><Insets bottom="16.0" left="30.0" top="16.0" /></padding>
                  </Button>

                  <Button fx:id="btnManageItem" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#showManageItem" style="-fx-background-color: transparent; -fx-text-fill: #d1d8e0; -fx-alignment: BASELINE_LEFT; -fx-cursor: hand; -fx-font-size: 15px;" text="        Quản Lý Sản Phẩm">
                     <padding><Insets bottom="16.0" left="30.0" top="16.0" /></padding>
                  </Button>

                  <Button fx:id="btnAdminPanel" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#showAdminPanel" style="-fx-background-color: transparent; -fx-text-fill: #d1d8e0; -fx-alignment: BASELINE_LEFT; -fx-cursor: hand; -fx-font-size: 15px;" text="        Quản Trị Hệ Thống">
                     <padding><Insets bottom="16.0" left="30.0" top="16.0" /></padding>
                  </Button>
               </children>
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <VBox style="-fx-border-color: #3b4e63; -fx-border-width: 1 0 0 0;">
               <children>
                  <Label text="TÀI KHOẢN" textFill="#8899a6">
                     <font><Font name="System Bold" size="11.0" /></font>
                     <VBox.margin>
                        <Insets bottom="10.0" left="30.0" top="20.0" />
                     </VBox.margin>
                  </Label>
                  <Button fx:id="btnProfile" graphicTextGap="14.0" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#showProfile" style="-fx-background-color: transparent; -fx-text-fill: #d1d8e0; -fx-alignment: BASELINE_LEFT; -fx-cursor: hand; -fx-font-size: 15px;" text="Hồ sơ cá nhân">
                     <graphic>
                        <Circle fx:id="circleMenuProfileAvatar" fill="#95a5a6" radius="22.0" />
                     </graphic>
                     <padding><Insets bottom="20.0" left="30.0" top="16.0" /></padding>
                  </Button>
               </children>
            </VBox>
         </children>
         <effect>
            <DropShadow color="#00000026" height="0.0" radius="7.0" width="15.0" />
         </effect>
      </VBox>
   </left>

   <!-- PHẦN CENTER: Vùng nội dung -->
   <center>
      <StackPane style="-fx-background-color: #f4f7f6;" BorderPane.alignment="CENTER">
         <children>
            <StackPane fx:id="contentArea" style="-fx-background-color: #f4f7f6;" />

            <VBox alignment="BOTTOM_RIGHT" mouseTransparent="false" pickOnBounds="false" spacing="12.0" StackPane.alignment="BOTTOM_RIGHT">
               <children>
                  <VBox fx:id="chatPanel" managed="false" maxHeight="450.0" maxWidth="350.0" minHeight="450.0" minWidth="350.0" prefHeight="450.0" prefWidth="350.0" spacing="0.0" style="-fx-background-color: #ffffff; -fx-background-radius: 14; -fx-border-color: #d7dee8; -fx-border-radius: 14;" visible="false">
                     <children>
                        <HBox alignment="CENTER_LEFT" prefHeight="54.0" spacing="8.0" style="-fx-background-color: #2b3d52; -fx-background-radius: 14 14 0 0;">
                           <children>
                              <Label text="Trợ lý ảo AuctionPro" textFill="WHITE">
                                 <font><Font name="System Bold" size="15.0" /></font>
                              </Label>
                              <Region HBox.hgrow="ALWAYS" />
                              <Button mnemonicParsing="false" onAction="#toggleChat" prefHeight="30.0" prefWidth="30.0" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 16px; -fx-cursor: hand;" text="✕" />
                           </children>
                           <padding>
                              <Insets left="16.0" right="10.0" />
                           </padding>
                        </HBox>

                        <ScrollPane fx:id="chatScrollPane" fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: #f7f9fc;" VBox.vgrow="ALWAYS">
                           <content>
                              <VBox fx:id="chatMessageContainer" spacing="10.0" style="-fx-background-color: #f7f9fc;">
                                 <padding>
                                    <Insets bottom="14.0" left="12.0" right="12.0" top="14.0" />
                                 </padding>
                              </VBox>
                           </content>
                        </ScrollPane>

                        <HBox alignment="CENTER" spacing="8.0" style="-fx-background-color: #ffffff; -fx-background-radius: 0 0 14 14; -fx-border-color: #e5e9f0; -fx-border-width: 1 0 0 0;">
                           <children>
                              <TextField fx:id="txtChatInput" onAction="#handleSendChat" promptText="Nhập câu hỏi..." HBox.hgrow="ALWAYS" style="-fx-background-color: #f1f4f8; -fx-background-radius: 18; -fx-border-color: transparent; -fx-padding: 9 13 9 13;" />
                              <Button fx:id="btnSendChat" mnemonicParsing="false" onAction="#handleSendChat" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-background-radius: 18; -fx-cursor: hand; -fx-padding: 9 16 9 16;" text="Gửi">
                                 <font><Font name="System Bold" size="13.0" /></font>
                              </Button>
                           </children>
                           <padding>
                              <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
                           </padding>
                        </HBox>
                     </children>
                     <effect>
                        <DropShadow color="#00000033" height="24.0" offsetY="6.0" radius="12.0" width="24.0" />
                     </effect>
                  </VBox>

                  <Button mnemonicParsing="false" onAction="#toggleChat" prefHeight="58.0" prefWidth="58.0" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-background-radius: 50; -fx-cursor: hand; -fx-font-size: 24px;" text="🤖">
                     <effect>
                        <DropShadow color="#3498db66" height="18.0" offsetY="4.0" radius="9.0" width="18.0" />
                     </effect>
                  </Button>
               </children>
               <padding>
                  <Insets bottom="24.0" right="24.0" />
               </padding>
            </VBox>
         </children>
      </StackPane>
   </center>
</BorderPane>
